# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# astro
/dist/
/.astro/

# netlify adapter build output (Frameworks API config + bundled SSR function)
/.netlify/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo

# lighthouse reports from `pnpm perf`
/.lighthouse/

# claude code local state. /.claude/worktrees/ is the one that matters: each
# entry there is a full working copy of this repo, which git would otherwise
# report as untracked in the main checkout. settings.json is left trackable on
# purpose — it is the shared, checked-in half of the config, and settings.local
# is the personal half.
/.claude/worktrees/
/.claude/settings.local.json
