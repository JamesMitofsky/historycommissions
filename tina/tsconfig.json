{
  // The Tina config is a React app compiled by the Tina CLI, not by Astro, so
  // it is type-checked on its own (`tsc -p tina`, part of `pnpm check`) with
  // React's JSX rather than under the root config's Astro/Svelte settings.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["__generated__"]
}
