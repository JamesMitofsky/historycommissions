---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PageContainer from "@/components/PageContainer.astro";
import BackLink from "@/components/BackLink.astro";
import FadeImage from "@/components/FadeImage.astro";
import PostArticle, {
  POST_IMAGE_FRAME_CLASS,
  POST_TITLE_CLASS,
} from "@/components/PostArticle.svelte";
import CommissionMap from "@/components/CommissionMap.svelte";
import { getPostEntries, toPost } from "@/blog";
import { resolveImage, getBlurDataURL } from "@/lib/images";
import { excerpt } from "@/lib/excerpt";
import { resolveCountries } from "@/lib/country";

export const getStaticPaths = (async () => {
  const entries = await getPostEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const post = toPost(entry);
const tags = resolveCountries(post.tags);
const description = excerpt(post.content, 200);

const image = resolveImage(post.image);
const blurDataURL = await getBlurDataURL(post.image);
---

<Layout
  title={post.title ?? undefined}
  description={description || undefined}
  ogType="article"
  publishedTime={post.date ?? undefined}
  ogImage={`/posts/${post.slug}/opengraph-image.png`}
>
  <PageContainer>
    <BackLink />

    <!-- The page body is shared with the CMS preview; see PostArticle. The
         title and image frame are slotted from here because they carry
         `transition:name`, which only applies to elements in .astro files. -->
    <PostArticle
      date={post.date}
      author={post.author}
      {tags}
      imageAttribution={post.imageAttribution}
      imageAttributionUrl={post.imageAttributionUrl}
      hasImage={image !== null}
    >
      {
        post.title && (
          <h1
            slot="title"
            class={POST_TITLE_CLASS}
            transition:name={`post-title-${post.slug}`}
          >
            {post.title}
          </h1>
        )
      }
      {
        tags.length > 0 && (
          <Fragment slot="map">
            <CommissionMap memberCountries={tags} client:visible />
          </Fragment>
        )
      }
      {
        image && (
          <div
            slot="image"
            class={POST_IMAGE_FRAME_CLASS}
            transition:name={`post-image-${post.slug}`}
          >
            <FadeImage
              src={image}
              alt={post.title ?? ""}
              priority
              sizes="(max-width: 768px) 100vw, 672px"
              widths={[672, 1344]}
              class="absolute inset-0 h-full w-full object-cover"
              blurDataURL={blurDataURL}
            />
          </div>
        )
      }
      <Content />
    </PostArticle>
  </PageContainer>
</Layout>
