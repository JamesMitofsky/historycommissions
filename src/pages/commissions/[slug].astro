---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageContainer from "@/components/PageContainer.astro";
import BackLink from "@/components/BackLink.astro";
import CommissionArticle, {
  COMMISSION_TITLE_CLASS,
} from "@/components/CommissionArticle.svelte";
import CommissionMap from "@/components/CommissionMap.svelte";
import { getCommissions } from "@/commissions/get-commissions";
import { describeCommission } from "@/commissions/view";
import { resolveCountries } from "@/lib/country";

export const getStaticPaths = (() =>
  getCommissions().map((commission) => ({
    params: { slug: commission.slug },
    props: { commission },
  }))) satisfies GetStaticPaths;

const { commission: c } = Astro.props;

const view = describeCommission(c);
const memberCountries = resolveCountries(c.memberCountries);
---

<Layout title={view.primaryName}>
  <PageContainer>
    <BackLink href="/commissions">← All commissions</BackLink>

    <!-- The body is shared with the CMS preview; see CommissionArticle. The
         title and the map are slotted from here because they carry
         `transition:name`, which only applies to elements in .astro files. -->
    <CommissionArticle commission={c} {view} {memberCountries}>
      <h1
        slot="title"
        class={COMMISSION_TITLE_CLASS}
        transition:name={`commission-title-${c.slug}`}
      >
        {view.primaryName}
      </h1>
      {
        memberCountries.length > 0 && (
          <div slot="map" transition:name={`commission-map-${c.slug}`}>
            <CommissionMap
              {memberCountries}
              aspectRatio={6 / 19}
              client:visible
            />
          </div>
        )
      }
    </CommissionArticle>
  </PageContainer>
</Layout>
