---
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import PageContainer from "@/components/PageContainer.astro";
import BackLink from "@/components/BackLink.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import MetaTable from "@/components/MetaTable.astro";
import StatusBadge from "@/components/StatusBadge.svelte";
import FlagTag from "@/components/FlagTag.svelte";
import CommissionMap from "@/components/CommissionMap.svelte";
import { getCommissions } from "@/commissions/get-commissions";
import { STATUS_LABELS } from "@/commissions/status";

export const getStaticPaths = (() =>
  getCommissions().map((commission) => ({
    params: { slug: commission.slug },
    props: { commission },
  }))) satisfies GetStaticPaths;

const { commission: c } = Astro.props;

const en = c.name.translations.find((t) => t.language === "en");
const primaryName = en?.name ?? c.name.englishName;
const hasAlternate = c.name.englishName !== primaryName;
const sponsors = c.sponsoringInstitutions.join(" · ") || null;

const otherNames = c.name.translations
  .filter((t) => t.language !== "en" && t.name !== c.name.englishName)
  .map((t) => t.name);

const linkClass =
  "group/link text-sm font-medium text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300 transition-colors underline underline-offset-4 decoration-sky-300 dark:decoration-sky-600";
const externalLinkClass =
  "text-sky-600 hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300 transition-colors underline underline-offset-4 decoration-sky-300 dark:decoration-sky-600";

const siteLink =
  c.linkStatus === "live" && c.url
    ? { href: c.url, label: "Website" }
    : c.linkStatus === "archived" && c.url
      ? { href: `https://web.archive.org/web/${c.url}`, label: "Archived copy" }
      : null;
---

<Layout title={primaryName}>
  <PageContainer>
    <BackLink href="/commissions">← All commissions</BackLink>

    <header class="mb-8">
      <StatusBadge status={c.status} />
      <div class="flex items-start justify-between gap-4 mt-1.5">
        <div class="min-w-0">
          <h1
            class="text-2xl font-semibold leading-tight text-foreground font-serif"
            transition:name={`commission-title-${c.slug}`}
          >
            {primaryName}
          </h1>
          {
            hasAlternate && (
              <p class="text-sm text-muted-foreground mt-1 leading-snug">
                {c.name.englishName}
              </p>
            )
          }
        </div>
        <div class="shrink-0 pt-1">
          {
            siteLink && (
              <a
                href={siteLink.href}
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                {siteLink.label}
                <span class="inline-block transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">
                  &nbsp;↗
                </span>
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="space-y-8">
      {
        c.memberCountries.length > 0 && (
          <div transition:name={`commission-map-${c.slug}`}>
            <CommissionMap
              memberCountries={c.memberCountries}
              aspectRatio={6 / 19}
              client:visible
            />
          </div>
        )
      }

      {
        otherNames.length > 0 && (
          <div>
            <SectionLabel>Other Names</SectionLabel>
            <ul class="space-y-0.5">
              {otherNames.map((n) => (
                <li class="text-sm text-muted-foreground leading-snug">{n}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        c.memberCountries.length > 0 && (
          <div>
            <SectionLabel>Member Countries</SectionLabel>
            <div class="flex flex-wrap gap-1.5">
              {c.memberCountries.map((country) => (
                <FlagTag tag={country} />
              ))}
            </div>
          </div>
        )
      }

      <div>
        <SectionLabel>Details</SectionLabel>
        <MetaTable
          rows={[
            { label: "Proposed", value: c.proposedDate?.slice(0, 4) ?? null },
            { label: "Founded", value: c.startDate?.slice(0, 4) ?? null },
            {
              label: "Last active",
              value: c.lastActiveStatusDate?.slice(0, 4) ?? null,
            },
            {
              label: "Last status",
              value: c.lastActiveStatus
                ? STATUS_LABELS[c.lastActiveStatus]
                : null,
            },
            { label: "Sponsors", value: sponsors },
          ]}
        />
      </div>

      {
        c.chairs.length > 0 && (
          <div>
            <SectionLabel>Chairs</SectionLabel>
            <ul class="space-y-1.5">
              {c.chairs.map((chair) => (
                <li class="text-sm text-foreground">
                  {chair.name}
                  {chair.affiliation && (
                    <span class="text-muted-foreground ml-1.5">
                      — {chair.affiliation}
                    </span>
                  )}
                  <span class="text-muted-foreground ml-1.5">
                    ({chair.country})
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        c.workingGroups.length > 0 && (
          <div>
            <SectionLabel>Working Groups</SectionLabel>
            <ul class="list-disc list-outside pl-4 space-y-1">
              {c.workingGroups.map((wg) => (
                <li class="text-sm text-foreground">{wg}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        c.keyTopics.length > 0 && (
          <div>
            <SectionLabel>Key Topics</SectionLabel>
            <ul class="list-disc list-outside pl-4 space-y-1">
              {c.keyTopics.map((topic) => (
                <li class="text-sm text-foreground">{topic}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        c.publications.length > 0 && (
          <div>
            <SectionLabel>Publications</SectionLabel>
            <ul class="list-disc list-outside pl-4 space-y-2.5">
              {c.publications.map((pub) => (
                <li class="text-sm text-foreground">
                  {pub.url ? (
                    <a
                      href={pub.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={externalLinkClass}
                    >
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                  {pub.year && (
                    <span class="text-muted-foreground ml-1.5">
                      ({pub.year})
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        c.archivableDocuments.length > 0 && (
          <div>
            <SectionLabel>Archivable Documents</SectionLabel>
            <ul class="list-disc list-outside pl-4 space-y-2">
              {c.archivableDocuments.map((doc) => (
                <li class="text-sm">
                  <a
                    href={doc.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={externalLinkClass}
                  >
                    {doc.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </PageContainer>
</Layout>
