---
import Layout from "@/layouts/Layout.astro";
import CommissionsList from "@/components/CommissionsList.svelte";
import { getCommissions } from "@/commissions/get-commissions";

const commissions = getCommissions();
---

<Layout title="Bilateral Commissions">
  <main class="max-w-2xl mx-auto px-6 pb-14 pt-8">
    <CommissionsList {commissions} client:load />
  </main>
</Layout>
