---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  blurDataURL?: string | null;
}

const {
  src,
  alt,
  class: className,
  sizes,
  widths,
  priority = false,
  blurDataURL,
} = Astro.props;

// SVGs are already resolution-independent; rasterizing the locator maps through
// the image service would only degrade them.
const isVector = src.format === "svg";

// A priority image is the one the page is judged on — on every page here that is
// the masthead, and Lighthouse names it as the LCP element. It does not fade.
//
// The fade is worth having for images that arrive late, because it covers the
// cut from blur placeholder to sharp source. Applied to the priority image it
// buys that same polish at the cost of the metric it is competing with: the fade
// starts at `opacity: 0`, so the element is not painted at all until the script
// at the end of Layout.astro sets `data-loaded` on it — which cannot happen
// before the whole document has been parsed. The image is then held back behind
// markup it has no dependency on.
//
// There is also nothing for the fade to cover here. The blur placeholder sits
// underneath at full opacity from the first frame, and this image is fetched at
// `fetchpriority="high"` with `decoding="sync"`, so the swap it would be
// smoothing is the fastest one on the page.
const fade = !priority;
---

{
  blurDataURL && (
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-cover bg-center"
      style={`background-image:url("${blurDataURL}")`}
    />
  )
}

{
  isVector ? (
    <img
      src={src.src}
      alt={alt}
      width={src.width}
      height={src.height}
      class={className}
      data-fade-img={fade || undefined}
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={className}
      sizes={sizes}
      widths={widths}
      priority={priority}
      data-fade-img={fade || undefined}
    />
  )
}
