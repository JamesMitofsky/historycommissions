---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  blurDataURL?: string | null;
}

const {
  src,
  alt,
  class: className,
  sizes,
  widths,
  priority = false,
  blurDataURL,
} = Astro.props;

// SVGs are already resolution-independent; rasterizing the locator maps through
// the image service would only degrade them.
const isVector = src.format === "svg";
---

{
  blurDataURL && (
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-cover bg-center"
      style={`background-image:url("${blurDataURL}")`}
    />
  )
}

{
  isVector ? (
    <img
      src={src.src}
      alt={alt}
      width={src.width}
      height={src.height}
      class={className}
      data-fade-img
      loading={priority ? "eager" : "lazy"}
      decoding={priority ? "sync" : "async"}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={className}
      sizes={sizes}
      widths={widths}
      priority={priority}
      data-fade-img
    />
  )
}
