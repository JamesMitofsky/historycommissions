---
import type { NavLink } from "@/settings";

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;

// The path is known at build time, so the active link is baked into each page
// and needs no client JS to work out where it is.
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<!-- Sits on the masthead and scrolls away with it, rather than being pinned to
     the viewport.

     Nothing is painted behind the links here. The bar used to carry a copy of
     the hero's blur placeholder plus a flat tint to fake frosted glass; the
     masthead now blurs its own top edge instead (see the gradient-blur layer in
     Layout.astro), so the frosting happens in the image and the bar itself is
     just text. What remains for legibility is the masthead's top-down gradient
     and the text-shadow below. -->
<nav
  class="absolute top-0 left-0 right-0 z-10 [text-shadow:0_1px_2px_rgb(0_0_0_/_0.5)]"
>
  <div
    class="max-w-2xl mx-auto px-6 h-12 sm:h-14 flex items-center justify-end gap-5 sm:gap-8"
  >
    {
      links.map(({ href, label, shortLabel }) => (
        <a
          href={href}
          class:list={[
            "relative text-base sm:text-base font-semibold tracking-wide transition-colors duration-200",
            isActive(href) ? "text-white" : "text-white/85 hover:text-white",
          ]}
        >
          <span class="sm:hidden">{shortLabel}</span>
          <span class="hidden sm:inline">{label}</span>
          {/* Rendered only under the current link, and named, so the view
              transition treats the underline on the outgoing page and the one on
              the incoming page as the same box and slides it across the bar. A
              per-link element that merely grew and shrank could not travel
              between two links, because a client-side navigation replaces the
              whole nav.

              The name is applied by the .nav-underline class rather than inline,
              so globals.css can withdraw it while the page is scrolled — see the
              rule there for why. */}
          {isActive(href) && (
            <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-full bg-white" />
          )}
        </a>
      ))
    }
  </div>
</nav>
